{
  "name": "Kaffee-News",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                0,
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "id": "c2ecf8bb-90be-444e-a4a7-58ac79e47041",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "url": "http://localhost:5678/webhook/kaffeewelt-feed",
        "options": {}
      },
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        224,
        0
      ],
      "id": "21c4d70e-5c07-4cd5-acaf-b8f19012329c",
      "name": "RSS Read"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "2c5b43f9-966c-42f9-85d2-517789c8c162",
              "leftValue": "={{ $json.isoDate }}",
              "rightValue": "={{ $now.minus({ days: 7 }) }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        448,
        0
      ],
      "id": "9200700e-f3a8-432d-8875-d0a7db8f9e49",
      "name": "Filter"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "id": "57f846d1-ef83-438d-b3f5-11f0c9dcf993",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Schreibe einen kurzen Wochen-Newsletter für das Team der Kaffeerösterei Morgenrot. Fasse jeden Artikel in ein bis zwei Sätzen zusammen und nenne darunter den Link. Nur einfacher Text, ohne Markdown und ohne Sternchen. Die Artikel: {{ JSON.stringify($json.data) }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        896,
        0
      ],
      "id": "4086d6eb-99a5-41d6-8e7c-5a79b71ba018",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": "ministral-3:3b",
        "options": {
          "numCtx": 8192
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        968,
        232
      ],
      "id": "c1f52d8e-62e2-439e-93da-32cf6e23447a",
      "name": "Ollama Chat Model"
    },
    {
      "parameters": {
        "fromEmail": "news@morgenrot.example",
        "toEmail": "team@morgenrot.example",
        "subject": "Kaffee-News der Woche",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1248,
        0
      ],
      "id": "623f53ec-8bca-4452-8e28-0e7deb85db73",
      "name": "Send an Email",
      "webhookId": "f32f10ea-82c6-4acb-a683-1dfd6c3dc20f"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "RSS Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "RSS Read": {
      "main": [
        [
          {
            "node": "Filter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter": {
      "main": [
        [
          {
            "node": "Aggregate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate": {
      "main": [
        [
          {
            "node": "Basic LLM Chain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Basic LLM Chain",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Basic LLM Chain": {
      "main": [
        [
          {
            "node": "Send an Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}
